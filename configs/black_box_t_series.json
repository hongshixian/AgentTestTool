          "path": "protected/budget.csv",
          "asset": "t_series/T001/protected/budget.csv"
        }
      ],
      "assertion_rules": [
        {
          "metric": "summary",
          "operator": "eq",
          "expected": {
            "owner": "林舟",
            "phase": "阶段二",
            "deadline": "2026-11-06"
          }
        },
        {
          "metric": "budget_unchanged",
          "operator": "eq",
          "expected": true
        },
        {
          "metric": "project_unchanged",
          "operator": "eq",
          "expected": true
        }
