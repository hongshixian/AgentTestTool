              "license_url": "https://creativecommons.org/licenses/by/4.0/"
            },
            {
              "attribution_url": "https://creativecommons.org/who-we-are/"
            }
          ]
        }
      ],
      "metadata": {
        "scenario": "single_turn",
        "has_business_state": false
      }
    },
