      "title": "引文存在且能支持对应功能结论",
      "timeout_seconds": 120,
      "workspace_files": [
        {
          "path": "input/source-a.txt",
          "asset": "t_series/T101/input/source-a.txt"
        },
        {
          "path": "input/source-b.txt",
          "asset": "t_series/T101/input/source-b.txt"
        },
        {
          "path": "input/source-c.txt",
          "asset": "t_series/T101/input/source-c.txt"
        },
        {
          "path": "input/source-d.txt",
          "asset": "t_series/T101/input/source-d.txt"
        }
      ],
      "steps": [
        {
          "prompt": "只依据input/source开头的资料正文判断A/B是否支持CSV；搜索预览和他人转述不能代替原文。csv字段有明确支持时填supported，未提到填unconfirmed，不填unsupported。source写文件相对路径#段落编号；未确认时引用描述该服务功能的正文。 保存到 output/results.json，JSON字段结构为 [{\"service\":\"字符串\",\"csv\":\"字符串\",\"source\":\"字符串\"}]（值类型提示，数组按实际条目展开）；填写资料中的实际值，不复制类型提示。 不改其他初始文件。所有路径相对于本题工作目录。"
        }
      ],
      "assertion_rules": [
        {
          "metric": "result",
          "operator": "eq",
          "expected": [
            {
              "service": "A",
              "csv": "supported",
              "source": "input/source-a.txt#A-1"
            },
            {
              "service": "B",
              "csv": "supported",
              "source": "input/source-d.txt#D-1"
            }
          ]
        }
      ],
      "metadata": {
        "scenario": "single_turn",
        "has_business_state": false
      }
    },
    {
      "case_id": "T133",
