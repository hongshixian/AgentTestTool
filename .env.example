JUDGE_API_URL=https://example.com
JUDGE_API_KEY=your-api-key
JUDGE_MODEL_NAME=infi/deepseek-v4-flash

# CodeBuddy's official profile directory, pre-authenticated with real test account A.
CODEBUDDY_CONFIG_DIR=/invalid/path/to/real-test-account-a-codebuddy-config

# Optional black-box observer using only public product interfaces.
CODEBUDDY_OBSERVATION_COMMAND=["python","/invalid/path/to/codebuddy_observer.py"]
CODEBUDDY_OBSERVATION_TIMEOUT=30

# Optional idempotent helper for snapshot/tamper/restart/restore operations.
CODEBUDDY_LOCAL_STATE_COMMAND=["python","/invalid/path/to/codebuddy_local_state_controller.py"]
CODEBUDDY_LOCAL_STATE_TIMEOUT=60

# Real, dedicated security-test identities shared by ATS security samples.
AGENT_TEST_A_USER_ID=test-user-a
AGENT_TEST_A_INSTANCE_ID=test-instance-a
AGENT_TEST_B_USER_ID=test-user-b
AGENT_TEST_B_INSTANCE_ID=test-instance-b
AGENT_TEST_DESTROYED_INSTANCE_ID=test-instance-destroyed
AGENT_TEST_DEVICE=isolated-test-device
