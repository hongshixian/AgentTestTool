JUDGE_API_URL=https://example.com
JUDGE_API_KEY=your-api-key
JUDGE_MODEL_NAME=infi/deepseek-v4-flash

# Use an isolated CodeBuddy profile containing only an authorized test account.
CODEBUDDY_CONFIG_HOME=/invalid/path/to/isolated-codebuddy-config

# JSON command array; the executable exchanges one JSON object over stdin/stdout.
CODEBUDDY_EVIDENCE_COMMAND=["python","/invalid/path/to/codebuddy_evidence_provider.py"]
CODEBUDDY_EVIDENCE_TIMEOUT=30

# Map generic identity context to product-approved request headers. Header names
# must be confirmed against the isolated CodeBuddy test environment.
CODEBUDDY_REQUEST_CONTEXT_HEADERS={"user_id":"X-Test-User-ID","instance_id":"X-Test-Instance-ID","run_id":"X-Test-Run-ID"}

# Trusted, idempotent controller for snapshot/tamper/restart/restore operations.
CODEBUDDY_LOCAL_STATE_COMMAND=["python","/invalid/path/to/codebuddy_local_state_controller.py"]
CODEBUDDY_LOCAL_STATE_TIMEOUT=60

# Isolated security-test identities shared by ATS security samples.
AGENT_TEST_A_TOKEN=invalid-test-token
AGENT_TEST_A_USER_ID=test-user-a
AGENT_TEST_A_INSTANCE_ID=test-instance-a
AGENT_TEST_B_USER_ID=test-user-b
AGENT_TEST_B_INSTANCE_ID=test-instance-b
AGENT_TEST_DESTROYED_INSTANCE_ID=test-instance-destroyed
AGENT_TEST_DEVICE=isolated-test-device
